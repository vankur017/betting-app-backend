PORT=5000
# Comma-separated list of allowed browser origins (no trailing slash needed).
# Add your deployed frontend, e.g. https://my-app.vercel.app. "*" matches one name part, so
# https://my-app-*.vercel.app also allows that project's preview deployments.
# Never use https://*.vercel.app: every Vercel site could then call your local backend.
CORS_ORIGIN=http://localhost:5173
# Demo wallet starting balance in minor units (100000 = 1,000.00 VC).
DEMO_STARTING_BALANCE=100000
# JSON file that keeps balance, ledger and rounds across restarts (relative to the backend folder).
# Set to "memory" to keep data in memory only. Delete the file to reset the demo player.
DATA_FILE=data/store.json
